flowchart LR

    U[User]
    A[Administrator]

    subgraph FRONTEND["Vue 3 Frontend"]
        UI[Views and Components]
        ROUTER[Vue Router]
        STORE[Authentication Store]
        APICLIENT[Axios API Client]
    end

    subgraph BACKEND["FastAPI Backend"]
        AUTH[Authentication and RBAC]
        PARKING[Parking Management]
        RES[Reservation Service]
        WALLET[Wallet and Payments]
        REVIEWS[Reviews]
        NOTIFY[Notifications]
        RECOMMEND[Parking Recommendation]
        PRICING[AI-Assisted Dynamic Pricing]
        ANALYTICS[Admin Analytics]
        MLAPI[Prediction Service]
    end

    subgraph DATA["Persistence Layer"]
        ORM[SQLAlchemy ORM]
        DB[(PostgreSQL)]
        MIG[Alembic Migrations]
    end

    subgraph AI["Machine Learning Layer"]
        MODEL[XGBoost Demand Model]
        MODELFILE[Joblib Model Artifact]
    end

